# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (local dev — zero setup)
DATABASE_URL=sqlite:///./omniskill.db

# Supabase PostgreSQL (production)
# Get this from Supabase → Project Settings → Database → Connection string (URI)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-char-random-string

# ─── Admin seeding ────────────────────────────────────────────────────────────
# Set both to auto-create admin on first startup (Render or local)
SEED_ADMIN_EMAIL=admin@omniskill.app
SEED_ADMIN_PASSWORD=replace-with-strong-password

# Invite code for registering extra admin accounts via signup form
ADMIN_INVITE_CODE=replace-with-secret-code

# ─── CORS / frontend ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Production:
# FRONTEND_URL=https://your-app.vercel.app
# CORS_ORIGINS=https://your-app.vercel.app

# ─── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
# Note: on Render free tier, disk resets on restart (uploads are session-only).
